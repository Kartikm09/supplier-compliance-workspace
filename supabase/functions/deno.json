{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "npm:@types/node@24.10.1"
    ],
    "lib": [
      "deno.ns",
      "dom",
      "dom.iterable",
      "esnext"
    ]
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "tasks": {
    "check": "deno check --all **/*.ts",
    "test": "deno test --allow-env"
  }
}
